{
	"name": "05_dates_demo",
	"properties": {
		"activities": [
			{
				"name": "s_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_sd",
					"value": {
						"value": "@pipeline().parameters.param_start_date",
						"type": "Expression"
					}
				}
			},
			{
				"name": "e_date",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "s_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ed",
					"value": {
						"value": "@pipeline().parameters.param_end_date",
						"type": "Expression"
					}
				}
			},
			{
				"name": "new_ed",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "e_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_new_ed",
					"value": {
						"value": "@adddays(variables('v_ed'),-1,'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "raw_folder_path",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "new_ed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_raw_folder_path",
					"value": {
						"value": "@concat(pipeline().parameters.param_folder_path,'/',formatDateTime(pipeline().TriggerTime,'yyyy'),'/',formatDateTime(pipeline().TriggerTime,'MM'),'/',formatDateTime(pipeline().TriggerTime,'dd'),'/',formatDateTime(pipeline().TriggerTime,'HH'),'/',formatDateTime(pipeline().TriggerTime,'mm'))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"param_start_date": {
				"type": "string",
				"defaultValue": "10-05-2024"
			},
			"param_end_date": {
				"type": "string",
				"defaultValue": "12-05-2024"
			},
			"param_folder_path": {
				"type": "string",
				"defaultValue": "raw/insight/"
			}
		},
		"variables": {
			"v_sd": {
				"type": "String"
			},
			"v_ed": {
				"type": "String"
			},
			"v_new_ed": {
				"type": "String"
			},
			"v_raw_folder_path": {
				"type": "String"
			}
		},
		"folder": {
			"name": "activities"
		},
		"annotations": []
	}
}