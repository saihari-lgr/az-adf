		{
			"name": "[concat(parameters('factoryName'), '/SchemaChanges')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Create Tables",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_az_sql_sample_db",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "IF NOT EXISTS(select  * from sys.tables where [name] = 'PipelineLogging')\r\nBEGIN\r\n\tCREATE TABLE PipelineLogging\r\n\t(\r\n\t\tId\tint PRIMARY KEY IDENTITY(1,1)\r\n\t\t,DataFactoryName\tVarchar(1000)\r\n\t\t,PipelineName\tVarchar(1000)\r\n\t\t,PipelineGroupId\tVarchar(1000)\r\n\t\t,PipelineRunId\tVarchar(1000)\r\n\t\t,PipelineTriggerId\tVarchar(1000)\r\n\t\t,PipelineTriggerName\tVarchar(1000)\r\n\t\t,PipelineTriggerTime\tVarchar(1000)\r\n\t\t,PipelineTriggerType\tVarchar(1000)\r\n\t\t,PipelinetriggeredByPipelineName\tVarchar(1000)\r\n\t\t,PipelinetriggeredByPipelineRunId\tVarchar(1000)\r\n\t\t,AddDate\tVarchar(100)\r\n\t)\r\nEND\r\n\r\n"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "usp_PipelineLogging",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Create Tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_az_sql_sample_db",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "create or alter procedure [dbo].[usp_PipelineLogging]\r\n(\r\n@DataFactoryName\tVarchar(1000)\r\n,@PipelineName\tVarchar(1000)\r\n,@PipelineGroupId\tVarchar(1000)\r\n,@PipelineRunId\tVarchar(1000)\r\n,@PipelineTriggerId\tVarchar(1000)\r\n,@PipelineTriggerName\tVarchar(1000)\r\n,@PipelineTriggerTime\tVarchar(1000)\r\n,@PipelineTriggerType\tVarchar(1000)\r\n,@PipelinetriggeredByPipelineName\tVarchar(1000)\r\n,@PipelinetriggeredByPipelineRunId\tVarchar(1000)\r\n,@AddDate\tVarchar(1000)\r\n)\r\nAS\r\nBEGIN\r\n\tINSERT INTO [dbo].[PipelineLogging] (\r\n\t\tDataFactoryName\r\n\t\t,PipelineName\r\n\t\t,PipelineGroupId\r\n\t\t,PipelineRunId\r\n\t\t,PipelineTriggerId\r\n\t\t,PipelineTriggerName\r\n\t\t,PipelineTriggerTime\r\n\t\t,PipelineTriggerType\r\n\t\t,PipelinetriggeredByPipelineName\r\n\t\t,PipelinetriggeredByPipelineRunId\r\n\t\t,AddDate\r\n\t)\r\n\tvalues\r\n\t(\r\n\t\t@DataFactoryName\r\n\t\t,@PipelineName\r\n\t\t,@PipelineGroupId\r\n\t\t,@PipelineRunId\r\n\t\t,@PipelineTriggerId\r\n\t\t,@PipelineTriggerName\r\n\t\t,@PipelineTriggerTime\r\n\t\t,@PipelineTriggerType\r\n\t\t,@PipelinetriggeredByPipelineName\r\n\t\t,@PipelinetriggeredByPipelineRunId\r\n\t\t,@AddDate\r\n\t)\r\nEND\r\n\r\n\r\n\r\n"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "poc"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_sql_sample_db')]"
			]
		},
