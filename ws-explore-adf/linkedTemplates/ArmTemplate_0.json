										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "page_count_incr",
										"value": {
											"value": "@add(variables('page_count_incr'),1)",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.12:00:00"
						}
					},
					{
						"name": "total_page",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "total_page",
							"value": 5
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"total_page": {
						"type": "Integer"
					},
					"page_count_incr": {
						"type": "Integer"
					}
				},
				"folder": {
					"name": "activities"
				},
				"annotations": []
			},
			"dependsOn": []
		},
